# SFSR-REMS environment template — copy to .env.local and fill in.
# This file is committed; .env.local is not.

# ── Firebase web config (public by design) ────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Cloudinary (public identifier) ────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ═══════════════════════════════════════════════════════════════════════════
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_.
# ═══════════════════════════════════════════════════════════════════════════
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Google reCAPTCHA v2 Checkbox ──────────────────────────────────────────
# https://www.google.com/recaptcha/admin — v2, "I'm not a robot" Checkbox.
# Registration fails closed while RECAPTCHA_SECRET_KEY is empty.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Local development only; ignored when NODE_ENV=production.
RECAPTCHA_DISABLED=

# ── Email (Nodemailer + Gmail SMTP) ───────────────────────────────────────
# Used for the password-reset OTP. NOT Firebase's built-in reset email —
# owning the send is what lets the content be branded.
#
# GMAIL_APP_PASSWORD must be an APP PASSWORD, not the account password.
# Google only issues one when 2-Step Verification is enabled on the account:
#   Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=St. Francis Square Realty
