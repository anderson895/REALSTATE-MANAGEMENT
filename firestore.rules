rules_version = '2';

// SFSR-REMS Firestore Security Rules
//
// Layer 3 of three (Development Plan.md §3.3). The proxy gate and the route
// handlers can both be bypassed by anyone talking to Firestore directly; this
// layer cannot. It is the only authorisation that the database itself enforces.
//
// Deny by default: there is no catch-all allow. A collection not listed here
// is unreachable from any client (§3.4, Fail-Safe Defaults).
//
// NOTE: the Admin SDK bypasses every rule in this file. Server code is trusted
// by design — see §12.27 on splitting the service account for least privilege.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isEmployee() {
      return signedIn() && claims().get('kind', '') == 'employee';
    }

    function isClient() {
      return signedIn() && claims().get('kind', '') == 'client';
    }

    function role() {
      return isEmployee() ? claims().get('role', '') : '';
    }

    function hasRole(allowed) {
      return role() in allowed;
    }

    // There is deliberately no isSupervisor() helper here.
    //
    // "All Supervisor per personnel is the approver of the transaction" is a
    // real rule, but it is enforced in Reservation.approve(by, isSupervisor)
    // and re-checked by can(actor, module, 'approve') on the server. Approvals
    // never arrive from a browser — every reservation write below is
    // `allow write: if false` — so a supervisor clause in these rules would be
    // unreachable code implying a control that is not actually here.

    /*
     * IT_ADMINISTRATOR — the SYSTEM, not the business.
     *
     * note.txt strips this role of walk-in buyers, payment entry, processing,
     * sales and finance: "accessible lang sa maintenance system only,
     * accessible add users only". So `isAdmin()` now appears only on the
     * collections that ARE the system — employees, the sales org roster and
     * the inventory catalogue — and nowhere near a client, a reservation, a
     * payment or a document.
     *
     * That is segregation of duties: an administrator who can create the
     * accounts and also verify the payments and approve the reservation can
     * move money alone, and nothing in the audit trail would look unusual.
     *
     * These rules are layer 3. The same restriction is in the RBAC matrix at
     * packages/domain/src/rbac/permissions.ts; move one and the other has to
     * move with it.
     */
    function isAdmin() {
      return role() == 'IT_ADMINISTRATOR';
    }

    // A Permanent Client; an Initial Account has tier == 'INITIAL'.
    function isPermanentClient() {
      return isClient() && claims().get('tier', '') == 'PERMANENT';
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Inventory — public read ────────────────────────────────────────────
    // RESERVATION.doc grants a Guest User "View all project details", so these
    // are readable without a session. Writes are staff-only.

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole(['MARKETING']);
    }

    /*
     * Units — public to read, and NOT writable by the role that adds them.
     *
     * That reads like a mistake and is not. Marketing holds UNIT_INVENTORY with
     * `create` and `modify` in the RBAC matrix, and adds stock at /inventory —
     * but every one of those writes goes through a server action using the
     * Admin SDK, which bypasses this file entirely. Granting MARKETING here
     * would add a SECOND path: a browser write that skips the id allocation,
     * the stats recompute and the `unit.created` audit entry, and could set a
     * unit's status to Sold with no reservation behind it.
     *
     * `isAdmin()` stays for the same reason it was written — a console-level
     * escape hatch — and status changes still flow through the reservation
     * transaction, never from a browser.
     */
    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /parkingSlots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Client accounts ────────────────────────────────────────────────────

    match /clients/{clientUid} {
      // A buyer sees their own record. Staff who work the file may read it:
      // Documentation owns the masterfile, Loans and Legal are granted
      // "View Client profile" in USER ROLE ACCESS.
      allow read: if owns(clientUid)
                  || hasRole(['DOCUMENTATION', 'LOAN_OFFICER',
                              'LEGAL_COUNSEL', 'ACCOUNT_RECEIVABLES']);
      allow create: if owns(clientUid);
      allow update: if owns(clientUid) || hasRole(['DOCUMENTATION']);
      // Client records are retained for audit — never deleted from a client.
      allow delete: if false;
    }

    // ── Employees ──────────────────────────────────────────────────────────

    match /employees/{employeeId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    match /salesOrg/{staffId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // ── Reservations ───────────────────────────────────────────────────────

    /*
     * Sales sees the OUTCOME, not the process.
     *
     * note.txt: "si sales agent hindi makaka receieved ng verification —
     * marerecieved lang ni sales agent kapag verified na lahat sa billing,
     * documentation, Documentation Supervisor."
     *
     * SALES was in the same list as everyone else here, which let an agent
     * read a reservation mid-verification: the unverified payment, the noted
     * deficiency and its reason. Splitting the clause is what actually
     * enforces the rule — the RBAC matrix works per MODULE and cannot express
     * "these rows but not those".
     *
     * Kept in step with SALES_VISIBLE_STATUSES in packages/domain/src/entities/
     * reservation.ts, which is what any Sales-facing query must filter on.
     */
    match /reservations/{reservationNo} {
      allow read: if isClient() && resource.data.clientId == request.auth.uid
                  || hasRole(['ACCOUNT_RECEIVABLES', 'DOCUMENTATION',
                              'BILLING', 'LOAN_OFFICER', 'CASH_CLERK'])
                  || (hasRole(['SALES'])
                      && resource.data.status in ['Approved', 'ContractSigned', 'Completed']);
      // Every write runs server-side inside a transaction that also updates the
      // unit and the audit log. Allowing browser writes would let a client
      // change its own status.
      allow write: if false;
    }

    // ── Payments and documents ─────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isClient() && resource.data.clientId == request.auth.uid
                  || hasRole(['ACCOUNT_RECEIVABLES', 'BILLING',
                              'CASH_CLERK', 'ACCOUNTING']);
      allow write: if false;
    }

    match /documents/{documentId} {
      allow read: if isClient() && resource.data.buyerUid == request.auth.uid
                  || hasRole(['DOCUMENTATION', 'LOAN_OFFICER',
                              'LEGAL_COUNSEL']);
      // Buyers upload; the OCR and validation fields are written server-side.
      allow create: if isClient() && request.resource.data.buyerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Statements of account ──────────────────────────────────────────────

    match /soa/{soaId} {
      // "View Statement of Account (SOA)" is a Permanent Client feature only.
      allow read: if isPermanentClient() && resource.data.clientId == request.auth.uid
                  || hasRole(['BILLING', 'ACCOUNTING',
                              'ACCOUNT_RECEIVABLES', 'LOAN_OFFICER']);
      allow write: if false;
    }

    // ── Scheduling and announcements ───────────────────────────────────────

    // A tripping request is raised by the buyer and CLAIMED by a sales agent —
    // INTERNAL.xls, WEB PORTAL TO INTERNAL item 1: "ACCEPT/CONFIRM TRIPPING
    // REQUEST (FIRST SALES AGENT TO ACCEPT)", approver column N/A. Nobody signs
    // it off; whoever gets there first takes it.
    //
    // `update` for SALES is therefore correct, and it is why the RBAC matrix in
    // packages/domain/src/rbac/permissions.ts grants SALES `modify` on
    // SCHEDULING even though the RBAC.xls row reads "view & print". The two
    // layers agreed on the wrong thing for a while; they now agree on this one.
    // Move one and the other has to move with it.
    match /trippings/{trippingId} {
      allow read: if isClient() && resource.data.clientId == request.auth.uid
                  || hasRole(['SALES', 'ACCOUNT_RECEIVABLES']);
      // Created from the Portal by the buyer, for the buyer. Never by staff.
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
      allow update: if hasRole(['SALES']);
      // Retained for history. A withdrawn request is a status change, not a gap.
      allow delete: if false;
    }

    /*
     * Announcements — public to read, server-only to write.
     *
     * `read: if true` because these are advertisements. A Guest User browsing
     * the Portal is exactly who they are for, and the images behind them sit on
     * the public Cloudinary CDN for the same reason.
     *
     * `write: if false` and NOT `hasRole(['MARKETING'])`, which is what this
     * said before anything was built on it. Every announcement is now written
     * by a server action that re-checks `create`/`delete` on ADVERTISEMENT,
     * denormalises the project name, and appends to `auditLogs` — and an audit
     * entry only tells the truth if there is no second path that skips it. A
     * browser write would let Marketing post with no trail, which is the one
     * thing this module was asked to guarantee.
     *
     * Same reasoning as /reservations, /payments and /documents above. The
     * Admin SDK bypasses these rules by design.
     */
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if owns(resource.data.recipientUid);
      allow write: if false;
    }

    // ── Audit trail — append only ──────────────────────────────────────────
    // RBAC.xls assigns "audit trail monitoring" to IT and "audit trail reports"
    // to Account Receivables. Neither may edit it. No role gets update or
    // delete, including IT_ADMINISTRATOR — a log an administrator can rewrite
    // provides no assurance (§3.6).

    match /auditLogs/{entryId} {
      allow read: if hasRole(['IT_ADMINISTRATOR', 'ACCOUNT_RECEIVABLES']);
      allow create: if false;   // server-side only, inside the transaction
      allow update: if false;
      allow delete: if false;
    }

    // ── Server-only collections ────────────────────────────────────────────
    // Reachable through the Admin SDK, invisible to every browser.

    match /usernames/{username} {
      // Readable would let anyone enumerate registered accounts.
      allow read, write: if false;
    }

    match /passwordResetCodes/{email} {
      // Hashed one-time passcodes. Sealed from the browser entirely.
      //
      // Readable would be an account-enumeration index keyed BY EMAIL — the
      // document id alone tells you the address exists — on top of handing
      // over the hashes. Writable would let anyone mint their own reset.
      // Only the Admin SDK touches this, from /api/auth/forgot-password and
      // /api/auth/verify-otp.
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
  }
}
